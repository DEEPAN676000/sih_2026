# AICTE Institution Complaint Monitoring System — Environment Variables
# Copy this file to .env and configure keys for live production services.

# Application Server Port
PORT=5173

# TheHive.ai Image Detection Provider (https://thehive.ai/)
# Model: AI Generated Image Detection v2
# Leave empty to run with the built-in compliant simulation boundary.
HIVE_API_KEY=
HIVE_API_URL=https://api.thehive.ai/api/v2/task/sync

# Complainant Identity / KYC Verification Provider
# Options: digilocker_sandbox, uidai_aadhaar_ekyc, gov_sandbox
KYC_PROVIDER=digilocker_sandbox
KYC_CLIENT_ID=
KYC_CLIENT_SECRET=
KYC_CALLBACK_URL=http://localhost:5173/api/kyc/callback
